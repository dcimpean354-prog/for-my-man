
<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Mihai — Your Day</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap');

:root {
  --bg: #f6f0e8;
  --paper: #fffaf4;
  --ink: #332820;
  --brown: #76583f;
  --muted: #8a7969;
  --line: #dfd0bf;
  --dark: #29211c;
  --gold: #c3a17b;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: 'DM Sans', sans-serif;
  font-weight: 300;
}

button { font: inherit; cursor: pointer; }

nav {
  position: fixed;
  z-index: 10;
  top: 0;
  width: 100%;
  padding: 18px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(246,240,232,.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid #e7dace;
}

.logo {
  font-family: 'Playfair Display', serif;
  font-size: 21px;
}

.logo span { color: var(--gold); }

.nav-links {
  display: flex;
  gap: 23px;
}

.nav-links a {
  text-decoration: none;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.nav-links a:hover { color: var(--brown); }

.menu-btn {
  display: none;
  border: 0;
  background: none;
  font-size: 24px;
}

.hero {
  min-height: 100vh;
  padding: 140px 25px 70px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  overflow: hidden;
  background: radial-gradient(ellipse, #ead9c5 0%, #f6f0e8 68%);
}

.hero:before, .hero:after {
  content: "";
  position: absolute;
  width: 300px;
  height: 300px;
  border: 1px solid rgba(118,88,63,.22);
  border-radius: 50%;
}

.hero:before { top: -190px; left: -100px; }
.hero:after { bottom: -220px; right: -100px; }

.hero-content {
  position: relative;
  max-width: 750px;
  animation: enter 1.2s ease both;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 4px;
  font-size: 10px;
  color: var(--brown);
}

h1, h2, h3, .serif {
  font-family: 'Playfair Display', Georgia, serif;
  font-weight: 400;
}

h1 {
  font-size: clamp(58px, 11vw, 115px);
  line-height: 1.02;
  letter-spacing: -3px;
  margin: 28px 0;
}

h1 em, h2 em {
  color: var(--brown);
  font-weight: 400;
}

.hero p {
  max-width: 470px;
  margin: auto;
  color: var(--muted);
  font-size: 14px;
  line-height: 2;
}

.btn {
  border: 1px solid var(--dark);
  background: var(--dark);
  color: white;
  padding: 15px 24px;
  font-size: 10px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-top: 32px;
  transition: .25s;
}

.btn:hover {
  background: transparent;
  color: var(--dark);
}

section { padding: 95px 7%; }

.container {
  max-width: 950px;
  margin: auto;
}

.section-head {
  max-width: 600px;
  margin: 0 auto 48px;
  text-align: center;
}

.section-head h2 {
  font-size: clamp(34px, 5vw, 54px);
  line-height: 1.2;
  margin: 18px 0;
}

.section-head p {
  color: var(--muted);
  font-size: 13px;
  line-height: 2;
}

.birthday-note {
  max-width: 730px;
  margin: auto;
  background: var(--paper);
  padding: clamp(28px, 6vw, 65px);
  border: 1px solid #e7d9c8;
  text-align: center;
  position: relative;
}

.birthday-note:before {
  content: "✳";
  position: absolute;
  top: 20px;
  right: 25px;
  font-size: 22px;
  color: var(--gold);
}

.birthday-note h3 {
  font-size: 32px;
  margin: 18px 0;
}

.birthday-note p {
  color: var(--muted);
  font-size: 14px;
  line-height: 2.2;
}

.dark-section {
  background: var(--dark);
  color: var(--paper);
}

.dark-section .eyebrow { color: var(--gold); }

.dark-section .section-head p { color: #c5b6a6; }

.countdown {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  max-width: 700px;
  margin: 45px auto 0;
}

.time-unit {
  text-align: center;
  padding: 20px 8px;
  border-right: 1px solid #514237;
}

.time-unit:last-child { border: 0; }

.time-unit strong {
  font-family: 'Playfair Display', serif;
  display: block;
  font-size: clamp(32px, 6vw, 56px);
  font-weight: 400;
}

.time-unit span {
  display: block;
  margin-top: 8px;
  color: #c5b6a6;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.countdown-note {
  color: #c5b6a6;
  font-size: 12px;
  text-align: center;
  margin-top: 25px;
}

.reason-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.reason {
  background: var(--paper);
  border: 1px solid #e9ddd0;
  padding: 30px;
  min-height: 190px;
}

.reason .number {
  color: var(--gold);
  font-size: 11px;
  letter-spacing: 2px;
}

.reason h3 {
  font-size: 25px;
  margin: 20px 0 10px;
}

.reason p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.9;
  margin-bottom: 0;
}

.letters {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.letter {
  padding: 25px;
  background: #ede1d3;
  border: 1px solid #dfcfbd;
}

.letter small {
  color: var(--brown);
  font-size: 9px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.letter h3 {
  font-size: 24px;
  min-height: 55px;
}

.letter p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.9;
}

.letter button {
  border: 0;
  border-bottom: 1px solid var(--brown);
  background: none;
  padding: 8px 0;
  color: var(--brown);
  font-size: 11px;
}

.letter-message {
  display: none;
  margin-top: 18px;
  padding-top: 15px;
  border-top: 1px solid #d5c2ad;
  font-size: 12px;
  line-height: 2;
  color: var(--ink);
}

.letter-message.open { display: block; }

.future {
  background: #e8dbcc;
}

.future-list {
  max-width: 640px;
  margin: auto;
}

.future-item {
  padding: 19px 0;
  border-bottom: 1px solid #d2bda8;
  display: flex;
  align-items: center;
  gap: 15px;
}

.future-item input {
  width: 18px;
  height: 18px;
  accent-color: var(--brown);
}

.future-item label {
  font-size: 13px;
  cursor: pointer;
}

.future-item input:checked + label {
  text-decoration: line-through;
  color: var(--muted);
}

.progress-text {
  text-align: right;
  margin-top: 18px;
  font-size: 11px;
  color: var(--brown);
}

.final {
  text-align: center;
  background: var(--dark);
  color: var(--paper);
  padding-top: 115px;
  padding-bottom: 115px;
}

.final h2 {
  font-size: clamp(42px, 8vw, 78px);
  line-height: 1.15;
  margin: 25px 0;
}

.final .eyebrow { color: var(--gold); }

.final p {
  max-width: 530px;
  margin: auto;
  color: #c5b6a6;
  font-size: 13px;
  line-height: 2.2;
}

.final button {
  background: transparent;
  color: white;
  border: 1px solid #9e8974;
  padding: 15px 25px;
  margin-top: 30px;
  font-size: 10px;
  letter-spacing: 1.5px;
}

.final button:hover { background: #504237; }

.final-message {
  display: none;
  max-width: 530px;
  margin: 35px auto 0;
  padding: 30px;
  border: 1px solid #514237;
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  line-height: 1.9;
}

.final-message.open { display: block; }

footer {
  background: #211b17;
  color: #a99a89;
  text-align: center;
  padding: 25px;
  font-size: 10px;
  letter-spacing: 2px;
}

#progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 3px;
  width: 0;
  background: var(--gold);
  z-index: 20;
}

.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: .7s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes enter {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 700px) {
  nav { padding: 15px 5%; }
  .menu-btn { display: block; }
  .nav-links {
    display: none;
    position: absolute;
    top: 60px;
    left: 0;
    right: 0;
    background: var(--bg);
    padding: 24px;
    flex-direction: column;
    text-align: center;
  }
  .nav-links.show { display: flex; }
  section { padding: 70px 6%; }
  .reason-grid, .letters { grid-template-columns: 1fr; }
  .reason { min-height: auto; }
  .countdown { grid-template-columns: 1fr 1fr; }
  .time-unit:nth-child(2) { border-right: none; }
  h1 { letter-spacing: -1px; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *:before, *:after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
</style>
</head>

<body>

<div id="progress"></div>

<nav>
  <div class="logo">For <span>M.</span></div>
  <button class="menu-btn" onclick="toggleMenu()">☰</button>
  <div class="nav-links" id="navLinks">
    <a href="#message" onclick="closeMenu()">Un mesaj</a>
    <a href="#countdown" onclick="closeMenu()">Ziua ta</a>
    <a href="#reasons" onclick="closeMenu()">De ce tu</a>
    <a href="#letters" onclick="closeMenu()">Scrisori</a>
  </div>
</nav>

<header class="hero">
  <div class="hero-content">
    <div class="eyebrow">A little something for you</div>
    <h1>Today is<br><em>about you.</em></h1>
    <p>
      Poate pentru tine este doar o altă zi din an.
      Pentru mine, însă, este ziua în care s-a născut
      unul dintre cei mai importanți oameni din viața mea.
    </p>
    <button class="btn" onclick="goTo('message')">
      Am ceva să-ți spun ↓
    </button>
  </div>
</header>

<section id="message">
  <div class="container reveal">
    <div class="section-head">
      <div class="eyebrow">Chapter 01 · Read this slowly</div>
      <h2>Poate tu nu înțelegi de ce contează atât de mult.</h2>
    </div>

    <div class="birthday-note">
      <div class="eyebrow">To my favorite person</div>
      <h3>La mulți ani, Pupsik.</h3>
      <p>
        Știu că poate pentru tine ziua ta nu este cine știe ce.
        Poate o vezi ca pe o zi obișnuită, poate nu simți nevoia
        să o sărbătorești prea mult sau poate nu îți dai seama
        cât de importantă este.
      </p>
      <p>
        Dar pentru mine este cea mai importantă zi din an.
        Pentru că, dacă ziua asta nu ar fi existat, nu s-ar fi
        născut omul care astăzi înseamnă atât de mult pentru mine.
      </p>
      <p>
        Nu este vorba doar despre tort, cadouri sau urări.
        Este despre faptul că lumea a primit un om care, fără
        să-și dea seama poate, a ajuns să ocupe un loc atât de
        important în viața mea.
      </p>
      <p>
        Așa că, indiferent cât de obișnuită ți se pare ție ziua
        asta, pentru mine nu va fi niciodată una oarecare.
        Este ziua ta. Și asta este suficient ca să fie specială.
      </p>
    </div>
  </div>
</section>

<section class="dark-section" id="countdown">
  <div class="container reveal">
    <div class="section-head">
      <div class="eyebrow">Chapter 02 · Your day</div>
      <h2>O zi care merită să fie sărbătorită.</h2>
      <p>
        Fiecare an în care exiști este un motiv în plus
        să mă bucur că drumurile noastre s-au întâlnit.
      </p>
    </div>

    <div class="countdown" id="countdownNumbers">
      <div class="time-unit">
        <strong id="days">--</strong>
        <span>Zile</>
      </div>
      <div class="time-unit">
        <strong id="hours">--</strong>
        <span>Ore</span>
      </div>
      <div class="time-unit">
        <strong id="minutes">--</strong>
        <span>Minute</span>
      </div>
      <div class="time-unit">
        <strong id="seconds">--</strong>
        <span>Secunde</span>
      </div>
    </div>

    <div class="countdown-note" id="birthdayNote">
      Până la următoarea zi de naștere a lui Mihai.
    </div>
  </div>
</section>

<section id="reasons">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">Chapter 03 · Why you</div>
      <h2>Lucruri pe care vreau să le știi.</h2>
      <p>
        Uneori nu spunem suficient de des lucrurile care contează.
        Astăzi vreau să ți le reamintesc.
      </p>
    </div>

    <div class="reason-grid">
      <div class="reason reveal">
        <div class="number">01 /</div>
        <h3>Pentru că exiști.</h3>
        <p>
          Nu trebuie să faci ceva extraordinar în fiecare zi
          ca să meriți să fii sărbătorit. Mă bucur pur și simplu
          că ești aici și că faci parte din viața mea.
        </p>
      </div>

      <div class="reason reveal">
        <div class="number">02 /</div>
        <h3>Pentru tot ce ești.</h3>
        <p>
          Îmi doresc să ai parte de lucruri bune, să crești,
          să reușești în ceea ce îți propui și să nu uiți
          cât de multe lucruri frumoase mai ai de trăit.
        </p>
      </div>

      <div class="reason reveal">
        <div class="number">03 /</div>
        <h3>Pentru povestea noastră.</h3>
        <p>
          În acești doi ani am adunat experiențe care fac parte
          din povestea noastră, inclusiv vara petrecută în America.
          Îmi doresc să mai avem multe capitole de scris.
        </p>
      </div>

      <div class="reason reveal">
        <div class="number">04 /</div>
        <h3>Pentru viitor.</h3>
        <p>
          Îți doresc să ajungi acolo unde îți dorești,
          să fii mândru de omul care devii și să ai motive
          să zâmbești când te gândești la viața ta.
        </p>
      </div>
    </div>
  </div>
</section>

<section style="background:#eee3d6" id="letters">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">Chapter 04 · Open when</div>
      <h2>Trei mesaje numai pentru tine.</h2>
      <p>
        Deschide-le pe rând. Fiecare este pentru un alt moment.
      </p>
    </div>

    <div class="letters">
      <div class="letter reveal">
        <small>Letter 01</small>
        <h3>Când uiți cât valorezi</h3>
        <p>Pentru zilele în care ai nevoie să auzi ceva bun.</p>
        <button onclick="toggleLetter('letter1',this)">Deschide mesajul +</button>
        <div class="letter-message" id="letter1">
          Îți doresc să vezi în tine toate lucrurile bune pe care
          poate uneori nu le observi. Nu trebuie să fii perfect,
          să reușești în toate sau să demonstrezi ceva tuturor.
          Ai voie să înveți, să greșești și să o iei de la capăt.
          Eu îți doresc să fii fericit cu omul care devii.
        </div>
      </div>

      <div class="letter reveal">
        <small>Letter 02</small>
        <h3>Când te gândești la noi</h3>
        <p>Pentru o zi obișnuită, în care vrei să zâmbești.</p>
        <button onclick="toggleLetter('letter2',this)">Deschide mesajul +</button>
        <div class="letter-message" id="letter2">
          Doi ani au trecut deja și încă avem atât de multe
          lucruri de trăit. Îmi doresc să ne susținem, să ne
          bucurăm de reușitele noastre și să ne construim
          amintiri pe care să le povestim peste ani.
          Astăzi este ziua ta, dar eu sărbătoresc și faptul
          că am ocazia să fiu lângă tine în povestea asta.
        </div>
      </div>

      <div class="letter reveal">
        <small>Letter 03</small>
        <h3>Peste câțiva ani</h3>
        <p>Pentru Mihai din viitor.</p>
        <button onclick="toggleLetter('letter3',this)">Deschide mesajul +</button>
        <div class="letter-message" id="letter3">
          Sper că ai ajuns mai aproape de lucrurile pe care
          ți le doreai când ai citit asta. Sper că ai motive
          să fii mândru de tine, că ai oameni buni alături
          și că nu ai renunțat la lucrurile care contează.
          Iar dacă ai uitat cât de specială este ziua ta,
          să știi că pentru mine tot va fi cea mai importantă
          zi din an.
        </div>
      </div>
    </div>
  </div>
</section>

<section class="future" id="future">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">Chapter 05 · Wishes for you</div>
      <h2>Ce îți doresc pentru anul care începe.</h2>
      <p>
        Mai mult decât obiecte sau cadouri, îți doresc lucruri
        pe care să le simți și să le păstrezi.
      </p>
    </div>

    <div class="future-list reveal">
      <div class="future-item">
        <input type="checkbox" id="wish1">
        <label for="wish1">Să ai curajul să urmărești ceea ce îți dorești.</label>
      </div>
      <div class="future-item">
        <input type="checkbox" id="wish2">
        <label for="wish2">Să fii sănătos și să ai liniște sufletească.</label>
      </div>
      <div class="future-item">
        <input type="checkbox" id="wish3">
        <label for="wish3">Să întâlnești oportunități care să te ducă mai departe.</label>
      </div>
      <div class="future-item">
        <input type="checkbox" id="wish4">
        <label for="wish4">Să ai parte de experiențe pe care să nu le uiți.</label>
      </div>
      <div class="future-item">
        <input type="checkbox" id="wish5">
        <label for="wish5">Să nu uiți niciodată că ești iubit.</label>
      </div>
      <div class="future-item">
        <input type="checkbox" id="wish6">
        <label for="wish6">Să ai un an de care să fii cu adevărat mândru.</label>
      </div>
    </div>
  </div>
</section>

<section class="final">
  <div class="container reveal">
    <div class="eyebrow">One last thing, Mihai</div>
    <h2>For the day<br><em>you were born.</em></h2>
    <p>
      Poate că nu ai nevoie de o zi specială ca să știi
      ce însemni pentru mine. Dar eu am vrut să-ți las ceva
      care să-ți amintească de asta.
    </p>

    <button onclick="toggleFinal()">Deschide ultimul mesaj ↓</button>

    <div class="final-message" id="finalMessage">
      La mulți ani, iubirea mea.<br><br>
      Poate pentru tine ziua ta este doar o zi din an.
      Pentru mine este ziua în care s-a născut omul
      pe care am ajuns să-l iubesc atât de mult.<br><br>
      Nu pot să-ți promit că fiecare zi va fi perfectă,
      dar îți doresc ca anul acesta să-ți aducă motive
      să fii fericit, liniștit și mândru de tine.<br><br>
      Iar astăzi vreau să știi un singur lucru:
      <em>ziua în care te-ai născut va avea mereu un loc
      special în inima mea.</em><br><br>
      Cu dragoste,<br>
      Denisa.
    </div>
  </div>
</section>

<footer>
  MADE FOR MIHAI · WITH LOVE, DENISA
</footer>

<script>
// MODIFICĂ AICI DATA NAȘTERII LUI MIHAI.
// Exemplu: "2005-05-14" — înlocuiește cu data reală.
const birthday = "2005-05-14";

function updateCountdown() {
  const parts = birthday.split("-").map(Number);
  const month = parts[1] - 1;
  const day = parts[2];
  const now = new Date();

  if (parts.length !== 3 || !day || !month >= 0) return;

  let nextBirthday = new Date(
    now.getFullYear(), month, day, 0, 0, 0
  );

  if (nextBirthday <= now) {
    nextBirthday = new Date(
      now.getFullYear() + 1, month, day, 0, 0, 0
    );
  }

  const diff = nextBirthday - now;

  if (diff <= 0) {
    document.getElementById("birthdayNote").textContent =
      "La mulți ani, Mihai! Astăzi este ziua ta.";
    return;
  }

  const days = Math.floor(diff / 86400000);
  const hours = Math.floor((diff % 86400000) / 3600000);
  const minutes = Math.floor((diff % 3600000) / 60000);
  const seconds = Math.floor((diff % 60000) / 1000);

  document.getElementById("days").textContent = days;
  document.getElementById("hours").textContent = hours;
  document.getElementById("minutes").textContent = minutes;
  document.getElementById("seconds").textContent = seconds;

  document.getElementById("birthdayNote").textContent =
    "Mai sunt " + days + " zile până la următoarea zi de naștere.";
}

function toggleLetter(id, button) {
  const message = document.getElementById(id);
  message.classList.toggle("open");
  button.textContent = message.classList.contains("open")
    ? "Închide mesajul −"
    : "Deschide mesajul +";
}

function toggleFinal() {
  document.getElementById("finalMessage").classList.toggle("open");
}

function goTo(id) {
  document.getElementById(id).scrollIntoView({behavior:"smooth"});
}

function toggleMenu() {
  document.getElementById("navLinks").classList.toggle("show");
}

function closeMenu() {
  document.getElementById("navLinks").classList.remove("show");
}

window.addEventListener("scroll", function() {
  const total = document.documentElement.scrollHeight - window.innerHeight;
  const percent = total > 0 ? window.scrollY / total * 100 : 0;
  document.getElementById("progress").style.width = percent + "%";
});

const observer = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add("visible");
      observer.unobserve(entry.target);
    }
  });
}, {threshold: 0.12});

document.querySelectorAll(".reveal").forEach(el => observer.observe(el));

updateCountdown();
setInterval(updateCountdown, 1000);
</script>

